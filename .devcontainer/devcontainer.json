{
  "name": "Stocker Mobile (Expo)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm install && npm install --global @expo/ngrok",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Expo",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
